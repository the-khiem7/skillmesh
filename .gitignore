state/

# personal values: created per machine with `Skillmesh.ps1 -Mode Init`
skillmesh.config.json

# agent folders: recreated per clone with `Skillmesh.ps1 -Mode Link`
.claude/
.kiro/
.agents/

.frontdoor/
.playwright-mcp/

# python bytecode and tool caches, created whenever skillmesh.py is imported or run
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
